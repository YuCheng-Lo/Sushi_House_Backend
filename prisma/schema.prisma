// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  nickname String?
  email    String  @unique
  password String

  failed_login_attempts Int       @default(0)
  locked_until          DateTime?

  created_at DateTime @default(now())

  sessions Session[]
}

model Session {
  id                 String @id @default(cuid())
  refresh_token_hash String @db.VarChar(255)

  user_agent String? @db.VarChar(500)
  ip_address String? @db.VarChar(45)

  expires_at DateTime
  revoked_at DateTime?

  version Int @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model Section {
  id        Int           @id @default(autoincrement()) @db.UnsignedInt
  name      String        @db.VarChar(100)
  sortOrder Int           @default(0) @db.UnsignedInt
  status    SectionStatus @default(HIDDEN)

  menuItems MenuItem[]
}

enum SectionStatus {
  ACTIVE
  HIDDEN
}

model MenuItem {
  id    Int     @id @default(autoincrement()) @db.UnsignedInt
  name  String  @db.VarChar(100)
  price Int     @db.UnsignedInt
  unit  String? @db.VarChar(50)

  option        String? @db.VarChar(100)
  description   String? @db.Text
  imageUrl      String? @db.VarChar(500)
  imagePublicId String? @db.VarChar(255)

  status    MenuItemStatus @default(HIDDEN)
  sortOrder Int            @default(0) @db.UnsignedInt

  sectionId Int     @db.UnsignedInt
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
}

enum MenuItemStatus {
  ACTIVE
  HIDDEN
}
